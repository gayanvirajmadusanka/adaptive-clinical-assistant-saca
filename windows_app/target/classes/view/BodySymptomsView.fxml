<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.saca.controller.BodySymptomsController"
            stylesheets="@/styles/style.css, @/styles/body-input.css"
            styleClass="root">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <left>
        <fx:include fx:id="sidebar" source="SidebarView.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    pannable="false" styleClass="center-scroll">
            <content>
                <StackPane styleClass="body-bg">

                    <VBox alignment="TOP_CENTER"
                          spacing="20"
                          maxWidth="680"
                          styleClass="body-card-container">

                        <padding><Insets top="30" right="36" bottom="60" left="36"/></padding>

                        <!-- HEADER -->
                        <HBox alignment="CENTER" styleClass="body-header-bar">

                            <Button onAction="#handleBack" styleClass="body-back-btn">
                                <graphic>
                                    <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                        <image><Image url="@/icons/back-arrow.png"/></image>
                                    </ImageView>
                                </graphic>
                            </Button>

                            <Label fx:id="partNameLabel"
                                   styleClass="body-title"
                                   HBox.hgrow="ALWAYS"
                                   maxWidth="Infinity"
                                   alignment="CENTER"/>

                            <Button fx:id="partSpeakerBtn"
                                    styleClass="body-back-btn"
                                    onAction="#handlePartSpeak">
                                <graphic>
                                    <ImageView fx:id="partSpeakerIcon"
                                               fitWidth="26" fitHeight="26"
                                               preserveRatio="true">
                                        <image><Image url="@/icons/speaker.png"/></image>
                                    </ImageView>
                                </graphic>
                            </Button>

                        </HBox>

                        <Label text="%body_symptoms_hint"
                               styleClass="body-hint-label"
                               alignment="CENTER"
                               maxWidth="Infinity"
                               wrapText="true"/>

                        <VBox fx:id="symptomsListBox" spacing="10" maxWidth="Infinity"/>

                        <Button fx:id="confirmBtn"
                                text="%confirm"
                                styleClass="body-confirm-btn"
                                maxWidth="Infinity"
                                onAction="#handleConfirm"/>

                    </VBox>

                </StackPane>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
